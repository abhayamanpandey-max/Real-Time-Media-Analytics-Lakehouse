# .env.example
# Copy this file to .env on the EC2 instance and fill in environment-specific values.
# DO NOT commit real secrets or production credentials to version control.

# Application Environment ('dev' or 'prod')
LAKEHOUSE_ENV=dev

# Mock API Security Token (Bearer authentication token)
API_TOKEN=dev-bearer-token-local

# API Base URL (Used by ingestion client to reach Mock API)
API_BASE_URL=http://localhost:8000

# Kafka Connection Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=audience-events-dev

# Container Service Port
PORT=8000

# Databricks Connection
DATABRICKS_HOST=dbc-aa73f553-354d.cloud.databricks.com
DATABRICKS_TOKEN=your-databricks-personal-access-token

# Databricks Genie Space IDs per Domain
GENIE_SPACE_ID_AUDIENCE=01f1a1fd42bf12c9b418f72e196ce123
GENIE_SPACE_ID_ENGAGEMENT=01f1a6065b871342b326e101c2469fb2
GENIE_SPACE_ID_COMPOSITION=01f1a6061e7110a69b5c9b4d3ccc16b4
GENIE_SPACE_ID_MONETIZATION=01f1a605b30a1a06ae28b8f2fc484f56
